{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 450,
  "height": 260,

  "data": {
    "url": "data/running_metrics_long.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "age_group",
      "type": "nominal",
      "sort": ["55+", "45-54", "35-44", "25-34", "18-24"],
      "title": "Age Group",
      "axis": {
        "grid": true
      }
    },
    "color": {
      "field": "age_group",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": ["18-24", "25-34", "35-44", "45-54", "55+"],
        "range": ["#0072B2", "#E69F00", "#009E73", "#CC79A7", "#7B3294"]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [0, 45]
          }
        },
        "x2": {
          "value": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 200
      },
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative",
          "title": "Participation (%)",
          "scale": {
            "domain": [0, 45]
          }
        },
        "tooltip": [
          {
            "field": "age_group",
            "type": "nominal",
            "title": "Age Group"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Participation Rate (%)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "value",
              "as": "mx"
            },
            {
              "op": "min",
              "field": "value",
              "as": "mn"
            }
          ]
        },
        {
          "calculate": "format(datum.value, '.1f') + '%' + (datum.value == datum.mx ? '  ◄ Peak' : datum.value == datum.mn ? '  ◄ Lowest' : '')",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [0, 45]
          }
        },
        "text": {
          "field": "lab",
          "type": "nominal"
        },
        "color": {
          "value": "#334155"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "transform": [
    {
      "filter": "datum.metric == 'participation_rate' && datum.age_group"
    }
  ]
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 450,
  "height": 260,
  "title": "Participation by Running Distance",
  "data": {
    "url": "data/participation_by_distance.csv"
  },
  "mark": {
    "type": "bar",
    "width": 28,
    "cornerRadiusTopLeft": 4,
    "cornerRadiusTopRight": 4
  },
  "encoding": {
    "x": {
      "field": "distance",
      "type": "nominal",
      "sort": ["5K", "10K", "Half", "Full"],
      "title": "Distance Category",
      "axis": { "labelAngle": 0 }
    },
    "y": {
      "field": "participants",
      "type": "quantitative",
      "title": "Total Participants",
      "axis": { "grid": true }
    },
    "color": {
      "field": "distance",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": ["5K", "10K", "Half", "Full"],
        "range": ["#56B4E9", "#E69F00", "#CC79A7", "#332288"]
      }
    },
    "tooltip": [
      { "field": "distance", "type": "nominal", "title": "Distance" },
      {
        "field": "participants",
        "type": "quantitative",
        "title": "Participants",
        "format": ","
      }
    ]
  },
  "config": {
    "view": { "stroke": null }
  }
}

      },
      "transform": [
        {
          "lookup": "State",
          "from": {
            "data": { "url": "data/australia_state_running.csv" },
            "key": "State",
            "fields": ["Participation_Rate"]
          }
        },
        {
          "calculate": "format(datum.Participation_Rate, '.1f') + '%'",
          "as": "pct_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 14,
        "fontWeight": "bold",
        "dy": 5
      },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "field": "pct_label", "type": "nominal" },
        "color": { "value": "#111827" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null }
  }

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 320,
  "height": 289,
  "title": "Running Times Per Week by Age Group",
  "data": {
    "url": "data/age_frequency_heatmap.csv"
  },
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "exercise_frequency",
      "type": "nominal",
      "title": "Running Frequency",
      "sort": ["1/week", "2/week", "3/week", "4/week", "5+/week"],
      "axis": { "labelAngle": 0 }
    },
    "y": {
      "field": "age_group",
      "type": "nominal",
      "sort": ["18-24", "25-34", "35-44", "45-54", "55+"],
      "title": "Age Group"
    },
    "color": {
      "field": "participant_percentage",
      "type": "quantitative",
      "title": "Share (%)",
      "scale": { "scheme": "orangered" }
    },
    "tooltip": [
      { "field": "age_group", "type": "nominal", "title": "Age Group" },
      {
        "field": "exercise_frequency",
        "type": "nominal",
        "title": "Frequency"
      },
      {
        "field": "participant_percentage",
        "type": "quantitative",
        "title": "Participant Share (%)"
      }
    ]
  },
  "config": {
    "view": { "stroke": null }
  }
}

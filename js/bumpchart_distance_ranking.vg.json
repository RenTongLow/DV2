{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 380,
  "height": 260,
  "title": "Distance Popularity Ranking Over Time",
  "data": {
    "url": "data/running_metrics_long.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number"
      }
    }
  },
  "config": {
    "view": {
      "stroke": null
    }
  },
  "transform": [
    {
      "filter": "datum.metric == 'rank'"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": true,
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "Popularity Rank",
          "scale": {
            "domain": [4, 1]
          },
          "axis": {
            "tickCount": 4,
            "grid": true
          }
        },
        "color": {
          "field": "distance",
          "type": "nominal",
          "title": "Distance",
          "scale": {
            "domain": ["5K", "10K", "Half", "Full"],
            "range": ["#56B4E9", "#E69F00", "#CC79A7", "#332288"]
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "distance",
            "type": "nominal",
            "title": "Distance"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Rank"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": 600,
        "color": "#64748b",
        "lineBreak": "\n",
        "baseline": "top",
        "dy": 10,
        "fontStyle": "normal"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [4, 1]
          }
        },
        "text": {
          "field": "lab",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.year == '2022' && datum.distance == '5K'"
        },
        {
          "calculate": "'5K is #1 every year'",
          "as": "lab"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": 600,
        "color": "#64748b",
        "lineBreak": "\n",
        "baseline": "bottom",
        "dy": -12,
        "dx": 18,
        "fontStyle": "normal"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [4, 1]
          }
        },
        "text": {
          "field": "lab",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.year == '2023' && datum.distance == 'Half'"
        },
        {
          "calculate": "'Half overtakes Full'",
          "as": "lab"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": 600,
        "color": "#64748b",
        "lineBreak": "\n",
        "baseline": "bottom",
        "dy": -12,
        "fontStyle": "normal"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [4, 1]
          }
        },
        "text": {
          "field": "lab",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.year == '2025' && datum.distance == 'Half'"
        },
        {
          "calculate": "'Half climbs to #2'",
          "as": "lab"
        }
      ]
    }
  ]
}

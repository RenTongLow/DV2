{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 450,
  "height": 260,
  "title": "Running Participation Rate by Age Group",
  "data": {
    "url": "data/participation_by_age.csv"
  },
  "encoding": {
    "y": {
      "field": "age_group",
      "type": "nominal",
      "sort": ["18-24", "25-34", "35-44", "45-54", "55+"],
      "title": "Age Group",
      "axis": { "grid": true }
    },
    "color": {
      "field": "age_group",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": ["18-24", "25-34", "35-44", "45-54", "55+"],
        "range": ["#0072B2", "#E69F00", "#009E73", "#CC79A7", "#7B3294"]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "participation_rate",
          "type": "quantitative",
          "scale": { "domain": [0, 40] }
        },
        "x2": { "value": 0 }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 200
      },
      "encoding": {
        "x": {
          "field": "participation_rate",
          "type": "quantitative",
          "title": "Participation (%)",
          "scale": { "domain": [0, 40] }
        },
        "tooltip": [
          { "field": "age_group", "type": "nominal", "title": "Age Group" },
          {
            "field": "participation_rate",
            "type": "quantitative",
            "title": "Participation Rate (%)"
          }
        ]
      }
    }
  ],
  "config": {
    "view": { "stroke": null }
  }
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 300,
  "height": 270,
  "title": "Participant Gender Composition",
  "data": {
    "url": "data/gender_composition.csv",
    "format": {
      "type": "csv",
      "parse": { "id": "number", "share_percentage": "number" }
    }
  },
  "transform": [
    {
      "window": [{ "op": "sum", "field": "share_percentage", "as": "cum" }],
      "sort": [{ "field": "id", "order": "ascending" }],
      "frame": [null, 0]
    },
    { "calculate": "round(datum.cum - datum.share_percentage)", "as": "start" },
    { "calculate": "round(datum.cum)", "as": "end" },
    { "calculate": "sequence(datum.start, datum.end)", "as": "n" },
    { "flatten": ["n"] },
    { "calculate": "floor(datum.n / 10)", "as": "row" },
    { "calculate": "datum.n % 10", "as": "col" }
  ],
  "layer": [
    {
      "mark": {
        "type": "square",
        "size": 300,
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "quantitative",
          "axis": null,
          "scale": { "domain": [-0.5, 9.5] }
        },
        "y": {
          "field": "row",
          "type": "quantitative",
          "axis": null,
          "scale": { "domain": [9.5, -0.5] }
        },
        "color": {
          "field": "gender",
          "type": "nominal",
          "title": "Gender",
          "scale": {
            "domain": ["Male", "Female"],
            "range": ["#2563eb", "#f97316"]
          },
          "legend": { "orient": "bottom", "direction": "horizontal" }
        },
        "tooltip": [
          { "field": "gender", "type": "nominal", "title": "Group" },
          {
            "field": "share_percentage",
            "type": "quantitative",
            "title": "Share (%)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            { "op": "mean", "field": "n", "as": "mean_n" },
            { "op": "max", "field": "share_percentage", "as": "share" }
          ],
          "groupby": ["gender"]
        },
        { "calculate": "(datum.mean_n + 0.5) / 10 - 0.5", "as": "row_mid" },
        { "calculate": "datum.share + '%'", "as": "label" }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 30,
        "fontWeight": "bold",
        "color": "#000000"
      },
      "encoding": {
        "x": {
          "datum": 4.5,
          "type": "quantitative",
          "axis": null,
          "scale": { "domain": [-0.5, 9.5] }
        },
        "y": {
          "field": "row_mid",
          "type": "quantitative",
          "axis": null,
          "scale": { "domain": [9.5, -0.5] }
        },
        "text": { "field": "label", "type": "nominal" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null }
  }
}

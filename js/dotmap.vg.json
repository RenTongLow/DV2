{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Australian Running Events Map",
  "width": 600,
  "height": 380,
  "projection": {
    "type": "mercator",
    "scale": 450,
    "center": [133.0, -27.0]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e5e7eb",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/all_runningcalendar_combined.csv"
      },
      "params": [
        {
          "name": "category_selection",
          "select": { "type": "point", "fields": ["category"] },
          "bind": {
            "input": "select",
            "options": [null, "Marathon", "Half Marathon", "10K", "5K"],
            "labels": ["All", "Marathon", "Half Marathon", "10K", "5K"],
            "name": "Category Filter: "
          }
        }
      ],
      "transform": [{ "filter": { "param": "category_selection" } }],
      "mark": {
        "type": "circle",
        "opacity": 0.6,
        "size": 60,
        "stroke": null
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": ["Marathon", "Half Marathon", "10K", "5K"],
            "range": ["#332288", "#CC79A7", "#E69F00", "#56B4E9"]
          },
          "legend": { "title": "Category" }
        },
        "tooltip": [
          { "field": "event_name", "type": "nominal", "title": "Event" },
          { "field": "category", "type": "nominal", "title": "Category" },
          { "field": "date", "type": "nominal", "title": "Date" },
          { "field": "location", "type": "nominal", "title": "Location" },
          { "field": "distance", "type": "nominal", "title": "Distance" }
        ]
      }
    }
  ],
  "config": {
    "view": { "stroke": null }
  }
}

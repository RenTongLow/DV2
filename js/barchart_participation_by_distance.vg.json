{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 430,
  "height": 260,
  "title": "Participation by Running Distance",
  "data": {
    "url": "data/running_metrics_long.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number"
      }
    }
  },
  "config": {
    "view": {
      "stroke": null
    }
  },
  "transform": [
    {
      "filter": "datum.metric == 'participants' && datum.distance"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "width": 28,
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4
      },
      "encoding": {
        "x": {
          "field": "distance",
          "type": "nominal",
          "sort": ["5K", "10K", "Half", "Full"],
          "title": "Distance Category",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "Total Participants",
          "axis": {
            "grid": true
          },
          "scale": {
            "domain": [0, 560000]
          }
        },
        "color": {
          "field": "distance",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": ["5K", "10K", "Half", "Full"],
            "range": ["#56B4E9", "#E69F00", "#CC79A7", "#332288"]
          }
        },
        "tooltip": [
          {
            "field": "distance",
            "type": "nominal",
            "title": "Distance"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Participants",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#334155",
        "lineBreak": "\n",
        "baseline": "bottom",
        "dy": -4
      },
      "encoding": {
        "x": {
          "field": "distance",
          "type": "nominal",
          "sort": ["5K", "10K", "Half", "Full"]
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [0, 560000]
          }
        },
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": ","
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": 400,
        "color": "#64748b",
        "lineBreak": "\n",
        "baseline": "bottom",
        "dy": -20,
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {
          "field": "distance",
          "type": "nominal",
          "sort": ["5K", "10K", "Half", "Full"]
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [0, 560000]
          }
        },
        "text": {
          "field": "note",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.distance == '5K' || datum.distance == 'Full'"
        },
        {
          "calculate": "datum.distance == '5K' ? 'Most popular' : 'Fewest participants'",
          "as": "note"
        }
      ]
    }
  ]
}
